{
  "uiScale": 1.1,
  "openGuideAtStartup": true,
  "topbarHelpIcon": true,
  "workspaceCount": 10,
  "wallpaperDir": "/home/lunanoir/.wallpaper-engine",
  "language": "us",
  "kbOptions": "grp:alt_shift_toggle",
  "monitors": [
    {
      "name": "eDP-1",
      "resW": 1920,
      "resH": 1080,
      "rate": 144,
      "x": 0,
      "y": 0,
      "scale": 1,
      "transform": 0
    }
  ],
  "keybinds": [
    {
      "type": "bindm",
      "mods": "$mainMod",
      "key": "mouse:272",
      "dispatcher": "movewindow",
      "command": "",
      "isEditing": false
    },
    {
      "type": "bindm",
      "mods": "$mainMod",
      "key": "mouse:273",
      "dispatcher": "resizewindow",
      "command": "",
      "isEditing": false
    },
    {
      "type": "bind",
      "mods": "ALT",
      "key": "F4",
      "dispatcher": "exec",
      "command": "hyprctl dispatch killactive",
      "isEditing": false
    },
    {
      "type": "bind",
      "mods": "$mainMod&SHIFT_L",
      "key": "F",
      "dispatcher": "exec",
      "command": "hyprctl dispatch togglefloating",
      "isEditing": false
    },
    {
      "type": "binde",
      "mods": "$mainMod&SHIFT_L",
      "key": "left",
      "dispatcher": "resizeactive",
      "command": "-50 0"
    },
    {
      "type": "binde",
      "mods": "$mainMod&SHIFT_L",
      "key": "right",
      "dispatcher": "resizeactive",
      "command": "50 0"
    },
    {
      "type": "binde",
      "mods": "$mainMod&SHIFT_L",
      "key": "up",
      "dispatcher": "resizeactive",
      "command": "0 -50"
    },
    {
      "type": "binde",
      "mods": "$mainMod&SHIFT_L",
      "key": "down",
      "dispatcher": "resizeactive",
      "command": "0 50"
    },
    {
      "type": "bind",
      "mods": "$mainMod&CTRL",
      "key": "left",
      "dispatcher": "movewindow",
      "command": "l",
      "isEditing": false
    },
    {
      "type": "bind",
      "mods": "$mainMod&CTRL",
      "key": "right",
      "dispatcher": "movewindow",
      "command": "r",
      "isEditing": false
    },
    {
      "type": "bind",
      "mods": "$mainMod&CTRL",
      "key": "up",
      "dispatcher": "movewindow",
      "command": "u",
      "isEditing": false
    },
    {
      "type": "bind",
      "mods": "$mainMod&CTRL",
      "key": "down",
      "dispatcher": "movewindow",
      "command": "d",
      "isEditing": false
    },
    {
      "type": "bind",
      "mods": "$mainMod",
      "key": "left",
      "dispatcher": "movefocus",
      "command": "l",
      "isEditing": false
    },
    {
      "type": "bind",
      "mods": "$mainMod",
      "key": "right",
      "dispatcher": "movefocus",
      "command": "r",
      "isEditing": false
    },
    {
      "type": "bind",
      "mods": "$mainMod",
      "key": "up",
      "dispatcher": "movefocus",
      "command": "u",
      "isEditing": false
    },
    {
      "type": "bind",
      "mods": "$mainMod",
      "key": "down",
      "dispatcher": "movefocus",
      "command": "d",
      "isEditing": false
    },
    {
      "type": "bind",
      "mods": "$mainMod",
      "key": "RETURN",
      "dispatcher": "exec",
      "command": "$terminal",
      "isEditing": false
    },
    {
      "type": "bind",
      "mods": "$mainMod",
      "key": "F",
      "dispatcher": "exec",
      "command": "firefox",
      "isEditing": false
    },
    {
      "type": "bind",
      "mods": "$mainMod",
      "key": "E",
      "dispatcher": "exec",
      "command": "nautilus",
      "isEditing": false
    },
    {
      "type": "bindl",
      "mods": "",
      "key": "Caps_Lock",
      "dispatcher": "exec",
      "command": "sleep 0.1 && swayosd-client --caps-lock",
      "isEditing": false
    },
    {
      "type": "bindl",
      "mods": "",
      "key": "XF86MonBrightnessDown",
      "dispatcher": "exec",
      "command": "swayosd-client --brightness lower",
      "isEditing": false
    },
    {
      "type": "bindl",
      "mods": "",
      "key": "XF86MonBrightnessUp",
      "dispatcher": "exec",
      "command": "swayosd-client --brightness raise",
      "isEditing": false
    },
    {
      "type": "bindl",
      "mods": "",
      "key": "Print",
      "dispatcher": "exec",
      "command": "~/.config/hypr/scripts/screenshot.sh",
      "isEditing": false
    },
    {
      "type": "bindl",
      "mods": "SHIFT_L",
      "key": "Print",
      "dispatcher": "exec",
      "command": "~/.config/hypr/scripts/screenshot.sh --edit",
      "isEditing": false
    },
    {
      "type": "bindl",
      "mods": "SUPER",
      "key": "Print",
      "dispatcher": "exec",
      "command": "~/.config/hypr/scripts/screenshot.sh --full",
      "isEditing": false
    },
    {
      "type": "bindl",
      "mods": "SUPER SHIFT_L",
      "key": "Print",
      "dispatcher": "exec",
      "command": "~/.config/hypr/scripts/screenshot.sh --full --edit",
      "isEditing": false
    },
    {
      "type": "bindl",
      "mods": "$mainMod",
      "key": "SPACE",
      "dispatcher": "exec",
      "command": "playerctl play-pause",
      "isEditing": false
    },
    {
      "type": "bindl",
      "mods": "",
      "key": "XF86AudioPause",
      "dispatcher": "exec",
      "command": "playerctl play-pause",
      "isEditing": false
    },
    {
      "type": "bindl",
      "mods": "",
      "key": "XF86AudioPlay",
      "dispatcher": "exec",
      "command": "playerctl play-pause",
      "isEditing": false
    },
    {
      "type": "bindl",
      "mods": "",
      "key": "xf86AudioMicMute",
      "dispatcher": "exec",
      "command": "swayosd-client --input-volume mute-toggle",
      "isEditing": false
    },
    {
      "type": "bindl",
      "mods": "",
      "key": "xf86audiomute",
      "dispatcher": "exec",
      "command": "swayosd-client --output-volume mute-toggle",
      "isEditing": false
    },
    {
      "type": "bindel",
      "mods": "",
      "key": "xf86audiolowervolume",
      "dispatcher": "exec",
      "command": "swayosd-client --output-volume lower",
      "isEditing": false
    },
    {
      "type": "bindel",
      "mods": "",
      "key": "xf86audioraisevolume",
      "dispatcher": "exec",
      "command": "swayosd-client --output-volume raise",
      "isEditing": false
    },
    {
      "type": "bind",
      "mods": "$mainMod",
      "key": "TAB",
      "dispatcher": "exec",
      "command": "~/.config/hypr/scripts/focus_next_monitor.sh",
      "isEditing": false
    }
  ],
  "startup": [
    {
      "command": "systemctl --user start hyprpolkitagent"
    },
    {
      "command": "awww-daemon"
    },
    {
      "command": "hypridle"
    },
    {
      "command": "quickshell -p ~/.config/hypr/scripts/quickshell/Shell.qml"
    },
    {
      "command": "~/.config/hypr/scripts/init.sh"
    },
    {
      "command": "playerctld"
    },
    {
      "command": "swayosd-server --top-margin 0.9 --style \"$HOME/.config/swayosd/style.css\""
    },
    {
      "command": "wl-paste --type text --watch cliphist store"
    },
    {
      "command": "wl-paste --type image --watch cliphist store"
    },
    {
      "command": "~/.config/hypr/scripts/volume_listener.sh"
    },
    {
      "command": "~/.config/hypr/scripts/update_notifier.sh"
    }
  ]
}
